# Normalise line endings: LF in the repository and in working copies,
# so Windows developers and Linux CI agree.
* text=auto eol=lf

# Maven wrapper: the shell script and its properties must stay LF, or mvnw breaks on Linux and macOS
mvnw text eol=lf
.mvn/wrapper/maven-wrapper.properties text eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.icns binary
*.jar binary
*.exe binary
*.msi binary
